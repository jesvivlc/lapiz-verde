{
  "manifest_version": 3,
  "name": "Pasar notas",
  "version": "1.0.0",
  "description": "Rellena las notas de tu cuaderno en la página de calificaciones que tengas abierta. Tú revisas y guardas.",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": { "default_popup": "popup.html", "default_title": "Pasar notas" },
  "content_scripts": [
    {
      "matches": ["https://lapizverde.com/*", "https://www.lapizverde.com/*"],
      "js": ["puente.js"],
      "run_at": "document_idle"
    }
  ]
}
