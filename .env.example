# Variables que la app necesita en Vercel (Settings → Environment Variables).
# Para desarrollo local: copiar a .env y rellenar.

# Anthropic — corrección con IA (ya configurada en producción)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase — clave de servicio (panel → Project Settings → API → service_role). ¡Nunca en el frontend!
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe — pagos (dashboard.stripe.com → Developers)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — envío del feedback por correo (opcional: sin esto, la app ofrece "Copiar")
RESEND_API_KEY=re_...
FROM_EMAIL=feedback@tudominio.es
